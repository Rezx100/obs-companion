{
  "name": "obs-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Local OBS recording and evidence-first website handoffs",
  "author": "OBS Companion contributors",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "esbuild ui/app.jsx --bundle --minify --define:process.env.NODE_ENV=\"\\\"production\\\"\" --outfile=ui/app.js --loader:.jsx=jsx",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "walkthrough": "node src/walkthrough.cjs",
    "mcp": "node src/mcp.cjs",
    "test:integration": "node scripts/integration.cjs",
    "package:win": "npm run build && electron-builder --win --dir --x64",
    "installer:custom": "node scripts/build-installer.cjs",
    "build:server": "esbuild server-ui/hash-worker.source.js --bundle --minify --outfile=server-ui/hash-worker.js",
    "server": "node src/server.cjs"
  },
  "dependencies": {
    "crypto-js": "4.2.0",
    "obs-websocket-js": "5.0.6",
    "playwright": "1.58.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sparticuz/chromium": "143.0.4",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "dev.rezan.obscompanion",
    "productName": "OBS Companion",
    "asar": true,
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json",
      "docs/**/*",
      "LICENSE",
      "resources/NOTICE.txt"
    ],
    "asarUnpack": [
      "node_modules/playwright*/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/browsers",
        "to": "browsers",
        "filter": [
          "**/*",
          "!.links/**"
        ]
      }
    ],
    "artifactName": "OBS-Companion-${version}-Setup.${ext}"
  }
}
